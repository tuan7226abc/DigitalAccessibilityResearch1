
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AccessLearn</title>
    <meta name="description" content="A student-centred digital accessibility research and learning platform." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg container py-3" aria-label="Main navigation">
            <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon" aria-hidden="true">A</span>
                <span>Access<span class="brand-highlight">Learn</span></span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">

                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Learning"
                           asp-action="Index">
                            Learning Centre
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Learning"
                           asp-action="MyLearning">
                            My Learning
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Survey"
                           asp-action="Index">
                            Survey
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#features">Accessibility</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#research">Research</a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Hello, @(User.Identity.Name ?? "Student")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-brand">
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    Sign in
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-brand" asp-controller="Account" asp-action="Register">
                                    Get started
                                </a>
                            </li>
                        }

                    
                </ul>
                <partial name="_LoginPartial" />
                

            </div>


        </nav>
    </header>

    <div class="access-toolbar" role="region" aria-label="Accessibility tools">
        <div class="container d-flex flex-wrap align-items-center justify-content-end gap-2 py-2">
            <span class="toolbar-label">Display settings</span>
            <button type="button" class="tool-button" id="decreaseText" aria-label="Decrease text size">A−</button>
            <button type="button" class="tool-button" id="increaseText" aria-label="Increase text size">A+</button>
            <button type="button" class="tool-button" id="contrastToggle" aria-pressed="false">
                High contrast
            </button>
            <button type="button" class="tool-button" id="resetDisplay">Reset</button>
        </div>
    </div>

    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <a class="navbar-brand brand footer-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon" aria-hidden="true">A</span>
                    <span>Access<span class="brand-highlight">Learn</span></span>
                </a>
                <p class="footer-description">
                    Making digital learning more accessible for every student.
                </p>
            </div>
            <p class="footer-copy">© @DateTime.Now.Year AccessLearn · Digital Accessibility Research</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            (() => {
                let textScale = 100;
                const body = document.body;
                const increase = document.getElementById("increaseText");
                const decrease = document.getElementById("decreaseText");
                const contrast = document.getElementById("contrastToggle");
                const reset = document.getElementById("resetDisplay");

                function updateTextScale() {
                    body.style.setProperty("--text-scale", textScale + "%");
                }

                increase.addEventListener("click", () => {
                    textScale = Math.min(150, textScale + 10);
                    updateTextScale();
                });

                decrease.addEventListener("click", () => {
                    textScale = Math.max(80, textScale - 10);
                    updateTextScale();
                });

                contrast.addEventListener("click", () => {
                    const enabled = body.classList.toggle("high-contrast");
                    contrast.setAttribute("aria-pressed", String(enabled));
                });

                reset.addEventListener("click", () => {
                    textScale = 100;
                    updateTextScale();
                    body.classList.remove("high-contrast");
                    contrast.setAttribute("aria-pressed", "false");
                });
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
