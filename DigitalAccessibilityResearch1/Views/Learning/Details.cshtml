@model DigitalAccessibilityResearch1.Models.Lesson

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumb" class="mb-4">
        <a asp-controller="Learning" asp-action="Index">
            Learning Centre
        </a>

        <span aria-hidden="true"> / </span>

        <span aria-current="page">@Model.Title</span>
    </nav>

    <article>

        <!-- LESSON HEADER -->
        <header class="mb-4">

            <p class="text-primary fw-semibold">
                @Model.Category
            </p>

            <h1>@Model.Title</h1>

            <p class="lead">
                @Model.Description
            </p>

            <p class="text-secondary">
                Estimated reading time:
                @Model.DurationMinutes minutes
            </p>

        </header>

        <!-- TEXT TO SPEECH -->
        <section class="card mb-4"
                 aria-labelledby="speech-heading">

            <div class="card-body">

                <h2 id="speech-heading" class="h5">
                    Listen to this lesson
                </h2>

                <p class="text-secondary">
                    You can listen to the lesson content instead of reading it.
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <button type="button"
                            id="lesson-speech-play"
                            class="btn btn-primary">
                        Listen
                    </button>

                    <button type="button"
                            id="lesson-speech-pause"
                            class="btn btn-outline-primary"
                            disabled>
                        Pause
                    </button>

                    <button type="button"
                            id="lesson-speech-stop"
                            class="btn btn-outline-secondary"
                            disabled>
                        Stop
                    </button>

                </div>

                <p id="lesson-speech-status"
                   class="mt-3 mb-0"
                   role="status"
                   aria-live="polite">
                    Text-to-Speech is ready.
                </p>

            </div>
        </section>

        <!-- VIDEO CAPTIONS AND TRANSCRIPT -->
        <section class="card mb-4"
                 aria-labelledby="video-heading">

            <div class="card-body p-4">

                <h2 id="video-heading" class="h4 mb-3">
                    Video lesson: Introduction to Digital Accessibility
                </h2>

                <p>
                    Watch the sample video below.
                    A transcript will be provided for the final lesson video.
                </p>

                <video class="w-100"
                       controls
                       preload="metadata"
                       playsinline
                       aria-label="Sample video">

                    <source src="https://www.w3schools.com/html/mov_bbb.mp4"
                            type="video/mp4" />

                    Your browser does not support HTML video.

                </video>

                <p class="text-secondary small mt-2 mb-0">
                    Note: This is a temporary sample video used to test
                    video playback. It is not the final Digital Accessibility video.
                </p>

            </div>
        </section>

        <!-- LESSON CONTENT -->
        <section class="card mb-4"
                 aria-labelledby="content-heading">

            <div class="card-body p-4">

                <h2 id="content-heading" class="h4 mb-3">
                    Lesson content
                </h2>

                <div id="lesson-speech-content">

                    <div class="speech-text mb-4">

                        <h2 class="h5">
                            @Model.Title
                        </h2>

                        <p>
                            @Model.Description
                        </p>

                        <div style="white-space: pre-line;">
                            @Model.Content
                        </div>

                    </div>

                    <!-- LEARNING OBJECTIVES -->
                    <section class="speech-text mb-4"
                             aria-labelledby="objectives-heading">

                        <h2 id="objectives-heading" class="h5">
                            Learning objectives
                        </h2>

                        <ul>
                            @foreach (var objective in Model.LearningObjectives)
                            {
                                <li class="mb-2">@objective</li>
                            }
                        </ul>

                    </section>

                </div>

            </div>
        </section>

        <!-- PRACTICE QUESTION -->
        <section class="card mb-4"
                 aria-labelledby="practice-heading">

            <div class="card-body p-4">

                <h2 id="practice-heading" class="h4">
                    Practice question
                </h2>

                <p>
                    @Model.Question
                </p>

                <!-- SERVER-SIDE RESULT MESSAGE -->
                @if (TempData["QuizMessage"] is string message)
                {
                    bool success =
                        TempData["QuizSuccess"] is bool value && value;

                    <div class="alert @(success ? "alert-success" : "alert-info")"
                         role="status"
                         aria-live="polite">

                        @message

                    </div>
                }

                <!-- ANSWER FORM -->
                <form id="lesson-quiz"
                      asp-controller="Learning"
                      asp-action="SubmitAnswer"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="lessonId"
                           value="@Model.Id" />

                    <fieldset>

                        <legend class="fs-6">
                            Select one answer
                        </legend>

                        @for (int i = 0; i < Model.Options.Count; i++)
                        {
                            var option = Model.Options[i];
                            var inputId = $"answer-{i}";

                            <div class="form-check mb-3">

                                <input class="form-check-input"
                                       type="radio"
                                       name="selectedAnswer"
                                       id="@inputId"
                                       value="@option"
                                       required />

                                <label class="form-check-label"
                                       for="@inputId">

                                    @option

                                </label>

                            </div>
                        }

                    </fieldset>

                    <button type="submit"
                            class="btn btn-primary mt-2">

                        Submit answer

                    </button>

                </form>

                <!-- EXPLANATION -->
                <details class="mt-3">

                    <summary class="fw-semibold">
                        Review the explanation
                    </summary>

                    <p class="mt-2">
                        @Model.Explanation
                    </p>

                </details>

            </div>
        </section>

        <!-- BACK BUTTON -->
        <a asp-controller="Learning"
           asp-action="Index"
           class="btn btn-outline-primary">

            Back to all lessons

        </a>

    </article>

</div>
