@model IEnumerable<DigitalAccessibilityResearch1.Models.Lesson>

@{
    ViewData["Title"] = "Learning Centre";
}

<main class="container py-5">
    <header class="mb-5">
        <p class="text-primary fw-semibold">ACCESSLEARN</p>
        <h1>Learning Centre</h1>
        <p class="lead">
            Explore digital accessibility and practise making online
            learning more inclusive.
        </p>
    </header>

    <section aria-labelledby="lesson-list-heading">
        <h2 id="lesson-list-heading" class="h4 mb-4">
            Available lessons
        </h2>

        <div class="row g-4">
            @foreach (var lesson in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm lesson-card">
                        <div class="card-body d-flex flex-column">

                            <p class="text-primary small fw-semibold lesson-category">
                                @lesson.Category
                            </p>

                            <h3 class="h5 card-title lesson-title">
                                @lesson.Title
                            </h3>

                            <p class="card-text lesson-description">
                                @lesson.Description
                            </p>

                            <p class="text-secondary small lesson-duration">
                                Estimated time:
                                @lesson.DurationMinutes minutes
                            </p>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm speech-button"
                                        data-speech-action="listen">
                                    <span aria-hidden="true">▶</span>
                                    Listen
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm speech-button"
                                        data-speech-action="pause"
                                        disabled>
                                    Pause
                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm speech-button"
                                        data-speech-action="stop"
                                        disabled>
                                    Stop
                                </button>
                            </div>

                            <a asp-controller="Learning"
                               asp-action="Details"
                               asp-route-id="@lesson.Id"
                               class="btn btn-primary mt-auto">
                                Start lesson
                            </a>

                        </div>
                    </article>
                </div>
            }
        </div>

        <p id="speech-status"
           class="visually-hidden"
           role="status"
           aria-live="polite">
        </p>
    </section>
</main>
